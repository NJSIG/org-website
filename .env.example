NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_IMAGE_OPTIMIZATION_API=YOUR_IMAGE_OPTIMIZATION_API_ENDPOINT_HERE
DATABASE_URI=YOUR_DATABASE_URI_HERE
PAYLOAD_SECRET=YOUR_SECRET_HERE
CRON_SECRET=YOUR_CRON_SECRET_HERE
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# S3 Storage
S3_ENDPOINT=YOUR_S3_ENDPOINT_HERE
S3_REGION=YOUR_S3_REGION_HERE
S3_BUCKET=YOUR_S3_BUCKET_HERE
S3_ACCESS_KEY_ID=YOUR_S3_ID_HERE
S3_SECRET_ACCESS_KEY=YOUR_S3_ACCESS_KEY_HERE

# Safe Fetch
SAFE_FETCH_ALLOW=hostname

# Google Maps API Key
NEXT_PUBLIC_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=website.tld
NEXT_PUBLIC_PLAUSIBLE_HOST=https://www.plausible.io

# Analytics Testing
# Set to true when running locally and testing analytics
# Should always be false or omitted in production and when not actively testing analytics
NEXT_PUBLIC_PLAUSIBLE_ON_LOCALHOST=false

# Analytics API
PLAUSIBLE_API_KEY=YOUR_PLAUSIBLE_API_KEY_HERE
PLAUSIBLE_API_HOST=YOUR_PLAUSIBLE_API_HOST_IF_DIFFERENT_FROM_PLAUSIBLE_HOST

# Email Config
# If using Mandrill your username should be meaningful
# and the password is the API key
SMTP_HOST=YOUR_SMTP_HOST_HERE
SMTP_USER=YOUR_SMTP_USER_HERE
SMTP_PASS=YOUR_SMTP_PASS_HERE

# Blurhash Config
# Blurhash has default values, you can omit this section if
# you are okay with the defaults
BLURHASH_SIZE=32
BLURHASH_COMPONENTS_X=3
BLURHASH_COMPONENTS_Y=3
