NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_IMAGE_OPTIMIZATION_API=YOUR_IMAGE_OPTIMIZATION_API_ENDPOINT_HERE
DATABASE_URI=YOUR_DATABASE_URI_HERE
PAYLOAD_SECRET=YOUR_SECRET_HERE
CRON_SECRET=YOUR_CRON_SECRET_HERE
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# S3 Storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Safe Fetch
# This list should include any hostnames you load images from,
# like S3 or image transformers
SAFE_FETCH_ALLOWLIST='[{"hostname":"s3.example.com","protocol":"https"},{"hostname":"cdn.example.com","protocol":"https"}]'

# Google Maps API Key
NEXT_PUBLIC_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Email Config
# If using Mandrill your username should be meaningful
# and the password is the API key
SMTP_HOST=YOUR_SMTP_HOST_HERE
SMTP_USER=YOUR_SMTP_USER_HERE
SMTP_PASS=YOUR_SMTP_PASS_HERE

# Blurhash Config
# Blurhash has default values, you can omit this section if
# you are okay with the defaults
BLURHASH_SIZE=32
BLURHASH_COMPONENTS_X=3
BLURHASH_COMPONENTS_Y=3

# Vercel Config
# Uncomment and set the values if deploying to Vercel
# VERCEL_PROJECT_PRODUCTION_URL=
