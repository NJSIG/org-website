{
  "npm.packageManager": "pnpm",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "editor.formatOnSaveMode": "file",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "[javascript][typescript][typescriptreact]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "material-icon-theme.folders.associations": {
    "access": "secure",
    "collections": "database",
    "blocks": "layout",
    "fields": "form",
    "globals": "global",
    "primitives": "atom",
    "(payload)": "admin",
    "(frontend)": "client",
    // Resets
    "(frontend)/events": "",
    "collections/Events": "",
    "collections/Pages": "",
    "components/Media": "",
    "fields/Link": "",
    "fields/Resource": ""
  },
  "material-icon-theme.folders.customClones": [
    {
      "name": "admin-views",
      "base": "admin",
      "color": "deep-purple-400",
      "folderNames": ["src/admin"]
    }
  ],
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#1a1a1a",
    "activityBar.background": "#1a1a1a",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#606020",
    "activityBarBadge.foreground": "#e7e7e7",
    "sideBar.border": "#1a1a1a"
  },
  "cSpell.words": [
    "bacceic",
    "Bento",
    "Blurhash",
    "bondi",
    "caip",
    "controlslist",
    "coolify",
    "devsafe",
    "Embla",
    "emdash",
    "ericnorth",
    "ericsouth",
    "ericwest",
    "hostnames",
    "Hoverable",
    "IDAT",
    "IEND",
    "IHDR",
    "importmap",
    "lucide",
    "Midlantic",
    "midtone",
    "minmax",
    "mocssif",
    "msword",
    "njeif",
    "njsg",
    "NJSIG",
    "nodownload",
    "nofullscreen",
    "noremoteplayback",
    "Noto",
    "officedocument",
    "oklab",
    "oklch",
    "openxmlformats",
    "payloadcms",
    "presentationml",
    "rfps",
    "scanline",
    "scanlines",
    "Segoe",
    "shadcn",
    "spreadsheetml",
    "Subfund",
    "subfunds",
    "sublicensable",
    "turbopack",
    "Vercel",
    "wordmark",
    "wordprocessingml",
    "xlarge"
  ]
}
